---
import HomePage from '../../components/pages/HomePage.astro';
import { locales, defaultLocale } from '../../i18n/index';
export function getStaticPaths() {
  return locales.filter(locale => locale !== defaultLocale).map(locale => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
---
<HomePage locale={locale} />
