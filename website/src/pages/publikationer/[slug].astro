---
import PublicationDetail from '../../components/pages/PublicationDetail.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){const records=await getCollection('publications',({data})=>!data.draft);return records.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;
---
<PublicationDetail entry={entry} locale="da" />
