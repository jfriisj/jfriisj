---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'da'));
---
<ArchiveLayout title="Projekter" description="Udvalgte projekter inden for software, el, automation og tekniske systemer.">
  <section class="wrap archive-hero">
    <a class="archive-breadcrumb" href="/">← Forside</a>
    <div class="eyebrow">Portfolio / Projekter</div>
    <h1 class="section-title">Projekter og tekniske løsninger.</h1>
    <p class="section-intro">Udvalgt arbejde med softwareudvikling, systemdesign, industri og tekniske installationer. Projekterne kan suppleres med billeder, kildekode og dokumentation.</p>
    <div class="archive-tools" data-archive-controls>
      <input class="archive-search" type="search" data-search aria-label="Søg i projekter" placeholder="Søg i projekter …" />
      <div class="archive-filters" role="group" aria-label="Filtrer projekter">
        <button type="button" data-filter="alle" aria-pressed="true">Alle</button>
        <button type="button" data-filter="software" aria-pressed="false">Software</button>
        <button type="button" data-filter="research" aria-pressed="false">Studie og research</button>
        <button type="button" data-filter="automation" aria-pressed="false">Automation</button>
        <button type="button" data-filter="electrical" aria-pressed="false">El</button>
        <button type="button" data-filter="network" aria-pressed="false">Netværk</button>
        <button type="button" data-filter="business" aria-pressed="false">Selvstændig</button>
      </div>
    </div>
    <p class="muted" data-result-count aria-live="polite">{projects.length} projekter</p>
  </section>
  <section class="wrap archive-footer-space" aria-label="Projektoversigt">
    {projects.length ? (
      <div class="archive-grid" data-archive-list>
        {projects.map(project => <ProjectCard entry={project} archive />)}
      </div>
    ) : <p class="archive-empty">Ingen projekter er offentliggjort endnu.</p>}
    <p class="archive-empty" data-no-results hidden>Ingen projekter matcher søgningen.</p>
  </section>
  <script is:inline src="/scripts/archive.js"></script>
</ArchiveLayout>
