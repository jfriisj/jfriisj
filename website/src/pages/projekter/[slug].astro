---
import ProjectDetail from '../../components/pages/ProjectDetail.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){const records=await getCollection('projects',({data})=>!data.draft);return records.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;
---
<ProjectDetail entry={entry} locale="da" />
