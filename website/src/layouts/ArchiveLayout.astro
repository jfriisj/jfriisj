---
import '../styles/global.css';
import '../styles/archive.css';
interface Props { title: string; description: string; locale: string; }
const { title, description, locale } = Astro.props;
const tr=(key:string)=>translate(locale,key);
import { translate, pathFor, locales, switchPath } from '../i18n/index';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import '../styles/i18n.css';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f7f3" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    {locales.map(code => <link rel="alternate" hreflang={code} href={new URL(switchPath(code,Astro.url.pathname),Astro.site).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchPath('da',Astro.url.pathname),Astro.site).toString()} />
    <title>{title} | Friis-Jakobsen</title>
  </head>
  <body>
    <header class="header">
      <nav class="wrap nav" aria-label={tr("Hovednavigation")}>
        <a class="brand" href={pathFor(locale,"/")} aria-label={tr("Friis-Jakobsen, til forsiden")}>{tr("friis—jakobsen")}<span class="dot">.</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navlinks" aria-label={tr("Åbn menu")}>
          <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
        </button>
        <div class="navlinks" id="navlinks">
          <a href={pathFor(locale,"/")}>{tr("Forside")}</a>
          <a href={pathFor(locale,"/") + "#om-mig"}>{tr("Om mig")}</a>
          <a href={pathFor(locale,"/") + "#kompetencer"}>{tr("Kompetencer")}</a>
          <a href={pathFor(locale,"/") + "#erfaring"}>{tr("Erfaring")}</a>
          <a href={pathFor(locale,"/projekter/")}>{tr("Projekter")}</a>
          <a href={pathFor(locale,"/publikationer/")}>{tr("Publikationer")}</a>
          <a href={pathFor(locale,"/") + "#kontakt"}>{tr("Kontakt")}</a>
        </div>
        <LanguageSwitcher locale={locale} pathname={Astro.url.pathname} />
      <a class="nav-contact" href={pathFor(locale,"/") + "#kontakt"}>{tr("Kontakt")} <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main class="archive-page" id="top">
      <slot />
    </main>
    <nav class="mobile-dock" aria-label={tr("Hurtig navigation")}>
      <a href={pathFor(locale,"/")}><span class="dock-icon" aria-hidden="true">⌂</span><span>{tr("Profil")}</span></a>
      <a href={pathFor(locale,"/") + "#erfaring"}><span class="dock-icon" aria-hidden="true">↗</span><span>{tr("CV")}</span></a>
      <a href={pathFor(locale,"/projekter/")}><span class="dock-icon" aria-hidden="true">▦</span><span>{tr("Projekter")}</span></a>
      <a href={pathFor(locale,"/publikationer/")}><span class="dock-icon" aria-hidden="true">≡</span><span>{tr("Artikler")}</span></a>
    </nav>
    <footer class="footer"><div class="wrap footer-inner"><span class="brand">{tr("friis—jakobsen.")}</span><span>{tr("Elektriker · Civilingeniør i software · Selvstændig")}</span><a href="https://github.com/jfriisj" rel="noopener noreferrer" target="_blank">{tr("GitHub ↗")}</a></div></footer>
    <script type="application/json" id="menu-labels" set:html={JSON.stringify({open:tr("Åbn menu"),close:tr("Luk menu")})} />
    <script is:inline>
      const menu = document.querySelector('.menu-toggle');
      const labels=JSON.parse(document.querySelector('#menu-labels')?.textContent||'{}');
      const links = document.querySelector('.navlinks');
      function closeMenu() {
        links?.classList.remove('open');
        menu?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-label', labels.open);
      }
      menu?.addEventListener('click', () => {
        const expanded = menu.getAttribute('aria-expanded') === 'true';
        links.classList.toggle('open', !expanded);
        menu.setAttribute('aria-expanded', String(!expanded));
        menu.setAttribute('aria-label', expanded ? labels.open : labels.close);
      });
      links?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') closeMenu(); });
      document.addEventListener('click', event => { if (!event.target.closest('.nav')) closeMenu(); });
    </script>
  </body>
</html>
