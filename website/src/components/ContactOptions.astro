---
import { translate } from '../i18n/index';
interface Props {locale: string;}
const {locale}=Astro.props;
const tr=(key: string)=>translate(locale,key);
const options=[
  {key:'private',email:'jonfjakobsen@gmail.com'},
  {key:'business',email:'simpeltnetvaerk@gmail.com'}
];
---
<div class="contact-options" aria-label={tr('contact.options.heading')}>
  {options.map(option => (
    <article class="contact-option">
      <div class="contact-option-copy">
        <h3>{tr('contact.'+option.key+'.title')}</h3>
        <p>{tr('contact.'+option.key+'.description')}</p>
      </div>
      <a class="contact-email" href={'mailto:'+option.email} aria-label={tr('contact.action')+': '+option.email}>
        <span class="contact-email-address">{option.email}</span>
        <span class="contact-email-action">{tr('contact.action')} <span aria-hidden="true">↗</span></span>
      </a>
    </article>
  ))}
</div>
<style>
  .contact-options{display:grid;gap:12px;flex:0 1 520px;min-width:0}
  .contact-option{border:1px solid #547570;border-radius:15px;background:#1c3636;padding:19px 21px;display:flex;flex-direction:column;gap:18px;min-width:0}
  .contact-option h3{font-size:17px;font-weight:730;margin:0 0 7px;color:#f5faf6;letter-spacing:-.02em}
  .contact-option p{color:#bdd1c9;font-size:13px;line-height:1.6;margin:0}
  .contact-email{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:13px;color:#fff;text-decoration:none;min-width:0}
  .contact-email-address{overflow-wrap:anywhere;text-decoration:underline;text-decoration-color:#8db9a9;text-underline-offset:4px}
  .contact-email-action{padding:8px 12px;border:1px solid #8caea3;border-radius:100px;font-weight:700;white-space:nowrap}
  .contact-email:hover .contact-email-action,.contact-email:focus-visible .contact-email-action{background:#cfeadd;color:#183c32}
  .contact-email:focus-visible{outline:3px solid #a3e4c6;outline-offset:5px;border-radius:4px}
  @media(max-width:900px){.contact-options{margin-top:24px;width:100%;flex:auto}}
  @media(max-width:420px){.contact-option{padding:17px}.contact-email-action{width:100%;text-align:center}}
</style>
