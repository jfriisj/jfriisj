---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'publications'>; locale: string; }
const { entry, locale } = Astro.props;
const tr=(key:string)=>translate(locale,key);
const pub = entry.data;
const label = tr(({ rapport: 'Rapport', artikel: 'Artikel', opgave: 'Studieopgave', andet: 'Andet' } as const)[pub.type]);
const title = tr(`publication.${entry.id}.title`);
const summary = tr(`publication.${entry.id}.summary`);
import { translate, pathFor } from '../i18n/index';
---
<article class="pub" data-reveal>
  <div class="pub-icon" aria-hidden="true">
    <svg width="28" height="34" fill="none" viewBox="0 0 28 34"><path d="M5 1.5h12l6 6V32H5z" stroke="currentColor" stroke-width="1.5"/><path d="M17 2v6h6M9 15h11M9 20h11M9 25h8" stroke="currentColor" stroke-width="1.5"/></svg>
  </div>
  <div>
    <div class="pub-type">{label}</div>
    <h3 class="pub-name"><a href={pathFor(locale,'/publikationer/' + entry.id + '/')}>{title}</a></h3>
    <p>{summary}</p>
  </div>
  <span class="pub-status">{tr(pub.pdf ? 'Læs online · PDF' : 'Læs online')}</span>
</article>
